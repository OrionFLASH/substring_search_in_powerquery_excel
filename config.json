{
  "output_file": "output/_base_gsz_keys.xlsx",
  "output_add_timestamp": true,
  "output_timestamp_format": "%Y%m%d_%H%M%S",
  "min_token_length": 2,
  "short_token_not_max_len": 5,
  "common_token_threshold": 80,
  "gsz_matcher_parallel": {
    "input_xlsx": "input/Tables+Holding.xlsx",
    "output_xlsx": "output/hold_od_gsz_python.xlsx",
    "output_add_timestamp": true,
    "output_timestamp_format": "%Y%m%d_%H%M%S",
    "holding_table": "_HOLD_OD",
    "base_table": "_base_gsz",
    "holding_column": "Холдинг",
    "holding_id_column": "ID холдинга",
    "gsz_column": "Наименование, регион",
    "and_full_cols": [
      "key_and_full_1",
      "key_and_full_2",
      "key_and_full_3"
    ],
    "and_not_cols": [
      "key_and_not_1",
      "key_and_not_2",
      "key_and_not_3"
    ],
    "and_non_cols": [
      "key_and_non_1",
      "key_and_non_2"
    ],
    "or_full_cols": [
      "key_or_full_1",
      "key_or_full_2",
      "key_or_full_3"
    ],
    "or_not_cols": [
      "key_or_not_1",
      "key_or_not_2",
      "key_or_not_3"
    ],
    "or_non_cols": [
      "key_or_non_1",
      "key_or_non_2"
    ],
    "_docs": {
      "prefilter": "Все непустые and_*/or_* токены (full и not) строки участвуют в предфильтре; кандидат при любом совпадении. Полная логика: AND → OR → non. Согласовано с PQ FAST/FAST_V2."
    },
    "fix_id_col": "key_fix_id",
    "match_status_texts": {
      "none": "-",
      "single": "найдено соответствие",
      "fixed": "зафиксированное значение",
      "multiple": "есть пересечения по ключам",
      "fix_not_found": "фикс значение не найдено",
      "fix_partial": "найдена часть фиксированных значений",
      "multiple_placeholder": ":=>"
    },
    "workers": 8,
    "work_batch_size": 30,
    "log_stages": true,
    "progress_every_holdings": 100,
    "progress_every_base_rows": 150,
    "progress_every_batches": 25,
    "progress_every_read_rows": 500,
    "heartbeat_seconds": 10,
    "show_current_holding": true,
    "diagnose_workbook_objects": true,
    "log_to_file": true,
    "logs_dir": "LOGS",
    "log_file_prefix": "gsz_matcher_parallel",
    "output_format": {
      "header_center": true,
      "header_wrap": true,
      "header_bold": true,
      "holding_freeze_rows": 1,
      "holding_freeze_cols": 3,
      "base_freeze_rows": 1,
      "base_freeze_cols": 3,
      "min_width_all": 30,
      "format_data_vertical_center": true,
      "holding_sheet": {
        "columns": {
          "gsz_primary": {"name": "Бренд", "width": 100},
          "gsz_debug": {"name": "Отладка_совпадения_Бренд", "width": 150, "wrap": true},
          "match_status": {"name": "статус", "width": 40, "wrap": true},
          "match_count": {"name": "Кол-во совпадений", "width": 30}
        }
      },
      "base_sheet": {
        "columns": {
          "holding_count": {"name": "кол-во холдингов", "width": 30},
          "found_holding": {"name": "найденный холдинг", "width": 100},
          "found_holding_debug": {"name": "Отладка_найденного_холдинга", "width": 150, "wrap": true},
          "match_status": {"name": "статус", "width": 40, "wrap": true},
          "key_string": {"name": "строка ключа", "width": 30},
          "key_length": {"name": "длина ключа", "width": 30},
          "key_repeat_count": {"name": "число повторов", "width": 30}
        }
      }
    }
  },
  "base_kg_inn_extract": {
    "input_xlsx": "input/base_kg_sample.xlsx",
    "output_xlsx": "output/base_kg_inn.xlsx",
    "output_add_timestamp": true,
    "output_timestamp_format": "%Y%m%d_%H%M%S",
    "output_sheet": "_BASE_KG_INN",
    "base_table": "_base_kg",
    "region_column": "Наименование, регион",
    "companies_column": "Компании группы (ЕРЗ)",
    "inn_keyword": "ИНН",
    "company_separators": [";", ","],
    "multi_value_joiner": ";\n",
    "output_columns": {
      "inn": "ИНН",
      "company_name": "Наименование",
      "region_name": "Наименование, регион",
      "region_count": "Кол-во регионов",
      "region_base_name": "Наименование без города",
      "region_base_count": "Кол-во наименований без города"
    },
    "log_to_file": true,
    "logs_dir": "log",
    "log_file_prefix": "INFO_base_kg_inn",
    "output_format": {
      "header_bold": true,
      "header_center": true,
      "header_wrap": true,
      "freeze_rows": 1,
      "freeze_cols": 1,
      "data_vertical_center": true,
      "data_horizontal": "left",
      "columns": {
        "inn": {"width": 30, "wrap": false},
        "company_name": {"width": 70, "wrap": true},
        "region_name": {"width": 100, "wrap": true},
        "region_count": {"width": 10, "wrap": false, "align": "center"},
        "region_base_name": {"width": 90, "wrap": true},
        "region_base_count": {"width": 10, "wrap": false, "align": "center"}
      }
    },
    "_docs": {
      "purpose": "Разбор колонки «Компании группы (ЕРЗ)» таблицы _base_kg в список уникальных ИНН с агрегацией названий и регионов.",
      "parse": "Фрагменты вида «Название (ИНН 1234567890)» разделяются company_separators; ключевое слово inn_keyword настраивается.",
      "aggregate": "Для одного ИНН разные названия и разные «Наименование, регион» склеиваются через multi_value_joiner (по умолчанию «;» + перенос строки).",
      "region_base": "«Наименование без города» — уникальные части «Наименование, регион» до первой запятой; region_count / region_base_count — количества уникальных значений."
    }
  }
}
